<odoo>
    <record id="view_real_estate_contract_form" model="ir.ui.view">
        <field name="name">real.estate.contract.form</field>
        <field name="model">real.estate.contract</field>
        <field name="arch" type="xml">
            <form string="Hợp đồng thuê lại">
                <group>
                    <field name="name"/>
                    <field name="state"/>
                    <field name="unit_id"/>
                    <field name="tenant_id"/>
                </group>
                <group string="Chi tiết">
                    <field name="rental_price"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <field name="notes"/>
            </form>
        </field>
    </record>

    <record id="view_real_estate_contract_tree" model="ir.ui.view">
        <field name="name">real.estate.contract.tree</field>
        <field name="model">real.estate.contract</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="rental_price"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_real_estate_contract" model="ir.actions.act_window">
        <field name="name">Hợp đồng cho thuê</field>
        <field name="res_model">real.estate.contract</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_real_estate_contract" name="Hợp đồng thuê lại" parent="menu_real_estate_root"
              action="action_real_estate_contract"/>
</odoo>
